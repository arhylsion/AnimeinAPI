# AnimeinAPI - environment configuration
# Copy this file to .env and adjust values as needed.
# All default values below match the public frontend defaults,
# so the API runs out of the box without a .env file.

# Source base URL (backend JSON is served via /api/proxy)
ANIMEIN_BASE_URL=https://animeinweb.com

# Public proxy header secret exposed by the frontend
ANIMEIN_PROXY_SECRET=animein-secure-proxy-key-123

# Upstream request timeout (seconds)
ANIMEIN_TIMEOUT=15

# Retry attempts for 429/5xx/network errors
ANIMEIN_RETRIES=2

# Log level: DEBUG / INFO / WARNING
ANIMEIN_LOG_LEVEL=INFO
